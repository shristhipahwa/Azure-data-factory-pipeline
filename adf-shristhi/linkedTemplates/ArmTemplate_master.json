{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-shristhi"
		},
		"linkedservice1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkedservice1'"
		},
		"http1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"linkedservice1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagedatalakeshristhi.dfs.core.windows.net/"
		},
		"Mantrigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/aa754e45-6bad-48f1-a9e0-9bd9510dda44/resourceGroups/RG_ADF/providers/Microsoft.Storage/storageAccounts/storagedatalakeshristhi"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-shristhi_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linkedservice1_accountKey": {
						"value": "[parameters('linkedservice1_accountKey')]"
					},
					"http1_properties_typeProperties_url": {
						"value": "[parameters('http1_properties_typeProperties_url')]"
					},
					"linkedservice1_properties_typeProperties_url": {
						"value": "[parameters('linkedservice1_properties_typeProperties_url')]"
					},
					"Mantrigger_properties_typeProperties_scope": {
						"value": "[parameters('Mantrigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}